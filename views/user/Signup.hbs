<div class="container-fluid py-5">
  <div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-lg border-0 scale-in" style="border-radius: 16px; overflow: hidden;">
        <!-- Card Header -->
        <div class="card-header bg-success text-white text-center py-4" style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%) !important;">
          <i class="bi bi-person-plus-fill display-3 mb-2"></i>
          <h3 class="mb-0">Create Account</h3>
          <p class="mb-0 opacity-75 small">Join us and start shopping!</p>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">
          <form action="/signup" method="post">
            <!-- Name Field -->
            <div class="form-group mb-3">
              <label for="name" class="form-label font-weight-bold">
                <i class="bi bi-person mr-2 text-success"></i>Full Name
              </label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-success text-white border-success">
                    <i class="bi bi-person"></i>
                  </span>
                </div>
                <input
                  type="text"
                  name="Name"
                  class="form-control border-left-0"
                  id="name"
                  placeholder="Enter your full name"
                  required
                  style="transition: all 0.3s ease;"
                >
              </div>
            </div>

            <!-- Email Field -->
            <div class="form-group mb-3">
              <label for="email" class="form-label font-weight-bold">
                <i class="bi bi-envelope mr-2 text-success"></i>Email Address
              </label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-success text-white border-success">
                    <i class="bi bi-at"></i>
                  </span>
                </div>
                <input
                  type="email"
                  name="Email"
                  class="form-control border-left-0"
                  id="email"
                  placeholder="Enter your email"
                  required
                  style="transition: all 0.3s ease;"
                >
              </div>
              <small class="form-text text-muted mt-2 d-block">
                <i class="bi bi-shield-check mr-1"></i>We'll never share your email.
              </small>
            </div>

            <!-- Password Field -->
            <div class="form-group mb-4">
              <label for="password" class="form-label font-weight-bold">
                <i class="bi bi-lock mr-2 text-success"></i>Password
              </label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-success text-white border-success">
                    <i class="bi bi-key"></i>
                  </span>
                </div>
                <input
                  type="password"
                  name="Password"
                  class="form-control border-left-0"
                  id="password"
                  placeholder="Create a password"
                  required
                  minlength="6"
                  style="transition: all 0.3s ease;"
                >
              </div>
              <small class="form-text text-muted mt-2">
                <i class="bi bi-info-circle mr-1"></i>Minimum 6 characters
              </small>
            </div>

            <!-- Terms and Submit -->
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-success btn-lg text-white font-weight-bold py-3" style="border: none; transition: all 0.3s ease;">
                <i class="bi bi-check-circle mr-2"></i> Create Account
              </button>
            </div>
          </form>
        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-light text-center py-3">
          <p class="mb-2">Already have an account?</p>
          <a href="/login" class="btn btn-outline-success px-4">
            <i class="bi bi-box-arrow-in-right mr-2"></i> Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .border-left-0 {
    border-left: 0;
  }

  .form-control:focus {
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    border-color: #28a745;
  }

  .card:hover {
    box-shadow: 0 8px 25px rgba(40, 167, 69, 0.2) !important;
  }

  .input-group-text {
    transition: background-color 0.3s ease;
  }
</style>