<div class="container-fluid py-5">
  <div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card shadow-lg border-0 scale-in" style="border-radius: 16px; overflow: hidden;">
        <!-- Card Header -->
        <div class="card-header bg-info text-white text-center py-4" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%) !important;">
          <i class="bi bi-person-circle display-3 mb-2"></i>
          <h3 class="mb-0">Welcome Back</h3>
          <p class="mb-0 opacity-75 small">Sign in to your account</p>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">
          <form action="/login" method="post">
            <!-- Email Field -->
            <div class="form-group mb-4">
              <label for="email" class="form-label font-weight-bold">
                <i class="bi bi-envelope mr-2 text-info"></i>Email Address
              </label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-info text-white border-info">
                    <i class="bi bi-at"></i>
                  </span>
                </div>
                <input
                  type="email"
                  class="form-control border-left-0"
                  id="email"
                  name="Email"
                  placeholder="Enter your email"
                  required
                  style="transition: all 0.3s ease;"
                >
              </div>
              {{#if EmailErr}}
                <div class="alert alert-danger mt-2 mb-0 fade-in" role="alert">
                  <i class="bi bi-exclamation-triangle mr-2"></i>
                  Incorrect email. Please check or sign up.
                </div>
              {{/if}}
              <small class="form-text text-muted mt-2 d-block">
                <i class="bi bi-shield-check mr-1"></i>We'll never share your email.
              </small>
            </div>

            <!-- Password Field -->
            <div class="form-group mb-4">
              <label for="password" class="form-label font-weight-bold">
                <i class="bi bi-lock mr-2 text-info"></i>Password
              </label>
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text bg-info text-white border-info">
                    <i class="bi bi-key"></i>
                  </span>
                </div>
                <input
                  type="password"
                  class="form-control border-left-0"
                  id="password"
                  name="Password"
                  placeholder="Enter your password"
                  required
                  style="transition: all 0.3s ease;"
                >
              </div>
              {{#if PasswordErr}}
                <div class="alert alert-danger mt-2 mb-0 fade-in" role="alert">
                  <i class="bi bi-exclamation-triangle mr-2"></i>
                  Incorrect password! Please recheck.
                </div>
              {{/if}}
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2 mb-3">
              <button type="submit" class="btn btn-info btn-lg text-white font-weight-bold py-3" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%); border: none;">
                <i class="bi bi-box-arrow-in-right mr-2"></i> Sign In
              </button>
            </div>
          </form>
        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-light text-center py-3">
          <p class="mb-2">Don't have an account?</p>
          <a href="/signup" class="btn btn-outline-info px-4">
            <i class="bi bi-person-plus mr-2"></i> Create Account
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .border-left-0 {
    border-left: 0;
  }

  .input-group-text {
    transition: background-color 0.3s ease;
  }

  .form-control:focus {
    box-shadow: 0 0 0 0.2rem rgba(23, 162, 184, 0.25);
    border-color: #17a2b8;
  }

  .card:hover {
    box-shadow: 0 8px 25px rgba(23, 162, 184, 0.2) !important;
  }
</style>
